{
  "name": "leon-mobile-app",
  "version": "0.11.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:android": "bun run --cwd modules/leon-link-native ubrn:android",
    "native:android:release": "bun run --cwd modules/leon-link-native ubrn:android:release",
    "native:ios": "bun run --cwd modules/leon-link-native ubrn:ios",
    "native:ios:release": "bun run --cwd modules/leon-link-native ubrn:ios:release",
    "native:generate": "bun run --cwd modules/leon-link-native ubrn:generate",
    "typecheck": "tsc --noEmit && bun run --cwd modules/leon-link-native typecheck",
    "lint": "expo lint",
    "test": "bun test src",
    "doctor": "expo-doctor",
    "check": "bun run typecheck && bun run lint && bun run test",
    "eas-build-pre-install": "bash scripts/eas-build-native.sh pre",
    "eas-build-post-install": "bash scripts/eas-build-native.sh post"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "leon-background": "workspace:*",
    "leon-link-native": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "^57.0.2",
    "expo-doctor": "^1.20.4",
    "typescript": "~6.0.3"
  }
}
