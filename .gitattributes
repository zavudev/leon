# Every text file is checked out with LF on every system. Tests compare
# generated text (docs/SETTINGS.md, docs/THEMES.md, the animated SVG files)
# with the files on disk, and shell scripts must not carry a carriage return.
* text=auto eol=lf

# Binary files: never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Scripts run by sh, bash or a desktop environment.
*.sh text eol=lf
*.desktop text eol=lf

# Third-party licence text, kept byte for byte as it was received (this one
# has CRLF line endings).
crates/app/assets/fonts/SpaceGrotesk-OFL.txt -text
